{
  "schemaVersion": 1,
  "conventions": {
    "numbers": "Adresses et valeurs en décimal ; tous les registres sont des mots 16 bits ; adresses de la doc en hexa (0x07D0 → 2000), aucun décalage",
    "requestBuild": "operation -> ComRequestConfigModel : { function: [operation.function], address, params: { length, value } }",
    "address": "scope 'fixed' : block.address.start",
    "length": "operation.params.length si présent, sinon 1",
    "value": "input 'enum' : enum[].value ; 'number' : entier brut",
    "scale": "Humidité, température et pH transmis × 10 (formule raw / 10) ; conductivité et NPK transmis tels quels",
    "temperature": "Température signée en complément à 2 (0xFF9B = -101 → -10.1 °C)",
    "npkAddresses": "Doc incohérente pour P et K : colonne hexa 0x0007 / 0x0008, colonne PLC 40006 / 40007 (= 0x0005 / 0x0006). Les blocs suivent la colonne hexa ; le bloc nutrientsScan lit 0x0004-0x0008 pour trancher sur l'appareil",
    "addressQuery": "Adresse 0xFF (255) acceptée en requête quand l'adresse est perdue : un seul capteur sur le bus, il répond avec son adresse réelle (ce n'est pas un broadcast Modbus)",
    "defaultValue": "Valeur usine du paramètre, au format de la valeur décodée du 1er champ (code enum ou nombre)",
    "views": "Bloc groupé (monitoring) : lecture des registres 0x0000-0x0003 en une trame, mêmes champs que les blocs unitaires",
    "danger": "true : l'opération peut couper la communication (confirmation requise)"
  },
