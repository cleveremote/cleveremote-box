{
  "schemaVersion": 1,
  "conventions": {
    "numbers": "Adresses et valeurs en décimal ; adresses de la doc en hexa (0x000C → 12), aucun décalage",
    "requestBuild": "operation -> ComRequestConfigModel : { function: [operation.function], address, params: { length, value } }",
    "address": "scope 'channel' : block.address.start + index × (address.stride ?? 1) ; scope 'range' et 'fixed' : block.address.start",
    "length": "operation.params.length si présent, sinon 1",
    "value": "input 'none' : input.fixedValue ; 'enum' : enum[].value ; 'number' : entier brut ; 'composite' : champs encodés par octet, un mot par 'word' ; 'number[]' : mots bruts",
    "fixedPoint": "Valeurs décimales sur 3 registres : partie entière int32 (2 mots, big-endian) + partie décimale × 100 (1 mot) ; valeur = entier + centièmes / 100 (ex : 00 00 00 07 00 32 → 7.50)",
    "fixedPointWrite": "Écriture d'une valeur décimale (writeRegisters, 3 mots) : [entier mot fort, entier mot faible, centièmes] (ex : total 10 L → [0, 10, 0])",
    "fields": "result 'fields' : champs décodés depuis la lecture (offset en mots) ; formules mathjs avec raw et les autres champs de la lecture",
    "wordOrder": "valeurs 32 bits : mot de poids fort en premier (hardware.wordOrder = highFirst)",
    "defaultValue": "Valeur usine du paramètre, au format de la valeur décodée du 1er champ (code enum ou nombre)",
    "views": "Blocs groupés (monitoring, configuration) : lecture de plusieurs registres en une trame, mêmes champs que les blocs unitaires",
    "danger": "true : l'opération peut couper la communication (adresse, vitesse) (confirmation requise)"
  },
