{
  "schemaVersion": 1,
  "conventions": {
    "numbers": "Adresses et valeurs en décimal ; tous les registres sont des mots 16 bits ; adresses de la doc en hexa (0x0016 → 22), aucun décalage",
    "requestBuild": "operation -> ComRequestConfigModel : { function: [operation.function], address, params: { length, value } }",
    "address": "scope 'channel' : block.address.start + index × (address.stride ?? 1) ; scope 'range' et 'fixed' : block.address.start",
    "length": "operation.params.length si présent, sinon 1",
    "value": "input 'none' : input.fixedValue ; 'enum' : enum[].value ; 'number' : entier brut, négatif émis en complément à 2",
    "decimalPoint": "Valeurs entières (PV, zéro, pleine échelle, offset) : valeur réelle = raw / 10^decimalPoint (registre 0x0003, lu via scopeFrom format.read)",
    "unit": "Unité de mesure lue au registre 0x0002 (enum measureUnit), appliquée par unitFrom",
    "wordOrder": "Flottant 0x0016 : IEEE754 big-endian ABCD, mot de poids fort en premier (hardware.wordOrder = highFirst)",
    "save": "Adresse, vitesse, parité et offset modifiés ne sont mémorisés qu'après l'écriture de saveToUser, envoyée avec le NOUVEAU format de communication",
    "defaultValue": "Valeur usine du paramètre, au format de la valeur décodée du 1er champ (code enum ou nombre)",
    "views": "Bloc groupé (monitoring) : lecture des registres 0x0000-0x0006 en une trame, mêmes champs que les blocs unitaires",
    "danger": "true : l'opération peut couper la communication ou réinitialiser la configuration (confirmation requise)"
  },
