  "registerMap": [
    {
      "id": "monitoring",
      "label": "Configuration et mesure (0x0000-0x0006)",
      "description": "Adresse, vitesse, unité, décimales, mesure et échelle en une seule lecture",
      "area": "holdingRegister",
      "access": "r",
      "address": {
        "start": 0,
        "count": 7
      },
      "operations": [
        {
          "id": "read",
          "label": "Lire configuration et mesure",
          "function": "readHoldingRegisters",
          "fc": 3,
          "scope": "fixed",
          "params": {
            "length": 7
          },
          "input": {
            "type": "none"
          },
          "result": {
            "type": "fields",
            "fields": [
              {
                "name": "deviceAddress",
                "label": "Adresse Modbus",
                "offset": 0,
                "type": "uint16"
              },
              {
                "name": "baudRate",
                "label": "Vitesse de communication",
                "offset": 1,
                "type": "uint16",
                "enum": "baudRate"
              },
              {
                "name": "unit",
                "label": "Unité de mesure",
                "offset": 2,
                "type": "uint16",
                "enum": "measureUnit"
              },
              {
                "name": "decimalPoint",
                "label": "Nombre de décimales",
                "offset": 3,
                "type": "uint16",
                "enum": "decimalPoint"
              },
              {
                "name": "pv",
                "label": "Mesure (PV)",
                "offset": 4,
                "type": "int16",
                "unitFrom": { "field": "unit", "enum": "measureUnit" },
                "formula": "raw / 10 ^ decimalPoint"
              },
              {
                "name": "rangeZero",
                "label": "Zéro de l'échelle",
                "offset": 5,
                "type": "int16",
                "unitFrom": { "field": "unit", "enum": "measureUnit" },
