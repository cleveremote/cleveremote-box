  "registerMap": [
    {
      "id": "inputs",
      "label": "Entrées analogiques 1~8",
      "description": "Valeur non signée ; unité selon le type de plage de la voie (mV, µA ou code brut)",
      "area": "inputRegister",
      "access": "r",
      "address": { "start": 0, "count": 8 },
      "operations": [
        {
          "id": "read",
          "label": "Lire les 8 entrées",
          "function": "readInputRegisters",
          "fc": 4,
          "scope": "range",
          "params": { "length": 8 },
          "input": { "type": "none" },
          "scopeFrom": ["inputRanges.read"],
          "result": {
            "type": "fields",
            "fields": [
              { "name": "ch1", "label": "Entrée 1", "offset": 0, "type": "uint16", "unitFrom": { "field": "rangeCh1", "enum": "inputRangeUnit" } },
              { "name": "ch2", "label": "Entrée 2", "offset": 1, "type": "uint16", "unitFrom": { "field": "rangeCh2", "enum": "inputRangeUnit" } },
              { "name": "ch3", "label": "Entrée 3", "offset": 2, "type": "uint16", "unitFrom": { "field": "rangeCh3", "enum": "inputRangeUnit" } },
              { "name": "ch4", "label": "Entrée 4", "offset": 3, "type": "uint16", "unitFrom": { "field": "rangeCh4", "enum": "inputRangeUnit" } },
              { "name": "ch5", "label": "Entrée 5", "offset": 4, "type": "uint16", "unitFrom": { "field": "rangeCh5", "enum": "inputRangeUnit" } },
              { "name": "ch6", "label": "Entrée 6", "offset": 5, "type": "uint16", "unitFrom": { "field": "rangeCh6", "enum": "inputRangeUnit" } },
              { "name": "ch7", "label": "Entrée 7", "offset": 6, "type": "uint16", "unitFrom": { "field": "rangeCh7", "enum": "inputRangeUnit" } },
              { "name": "ch8", "label": "Entrée 8", "offset": 7, "type": "uint16", "unitFrom": { "field": "rangeCh8", "enum": "inputRangeUnit" } }
            ]
          }
        },
        {
          "id": "readChannel",
          "label": "Lire une entrée",
          "function": "readInputRegisters",
          "fc": 4,
          "scope": "channel",
          "params": { "length": 1 },
          "input": { "type": "none" },
          "result": { "type": "number" }
        }
      ],
      "examples": [
        { "label": "Lire 8 entrées", "frame": "01 04 00 00 00 08 F1 CC" },
        { "label": "Réponse 8 entrées à 0", "frame": "01 04 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 55 2C" },
        { "label": "Lire entrée 1", "frame": "01 04 00 00 00 01 31 CA" },
        { "label": "Lire entrée 2", "frame": "01 04 00 01 00 01 60 0A" },
        { "label": "Lire entrées 3-5", "frame": "01 04 00 02 00 03 11 CB" }
      ]
    },
    {
      "id": "inputRanges",
      "label": "Type de plage des entrées 1~8",
      "area": "holdingRegister",
      "access": "rw",
      "address": { "start": 4096, "count": 8 },
      "operations": [
        {
          "id": "read",
          "label": "Lire les types de plage",
          "function": "readHoldingRegisters",
          "fc": 3,
          "scope": "range",
          "params": { "length": 8 },
          "input": { "type": "none" },
          "result": {
            "type": "fields",
            "fields": [
              { "name": "rangeCh1", "label": "Plage entrée 1", "offset": 0, "type": "uint16", "enum": "inputRange" },
              { "name": "rangeCh2", "label": "Plage entrée 2", "offset": 1, "type": "uint16", "enum": "inputRange" },
              { "name": "rangeCh3", "label": "Plage entrée 3", "offset": 2, "type": "uint16", "enum": "inputRange" },
              { "name": "rangeCh4", "label": "Plage entrée 4", "offset": 3, "type": "uint16", "enum": "inputRange" },
              { "name": "rangeCh5", "label": "Plage entrée 5", "offset": 4, "type": "uint16", "enum": "inputRange" },
              { "name": "rangeCh6", "label": "Plage entrée 6", "offset": 5, "type": "uint16", "enum": "inputRange" },
              { "name": "rangeCh7", "label": "Plage entrée 7", "offset": 6, "type": "uint16", "enum": "inputRange" },
              { "name": "rangeCh8", "label": "Plage entrée 8", "offset": 7, "type": "uint16", "enum": "inputRange" }
            ]
          }
        },
        {
          "id": "set",
          "label": "Définir la plage d'une entrée",
          "function": "writeRegister",
          "fc": 6,
          "scope": "channel",
          "input": { "type": "enum", "enum": "inputRange" },
          "result": { "type": "echo" }
        },
        {
          "id": "setAll",
          "label": "Définir les plages des 8 entrées",
          "function": "writeRegisters",
          "fc": 16,
          "scope": "range",
          "params": { "length": 8 },
          "input": { "type": "enum[]", "enum": "inputRange", "length": 8 },
          "result": { "type": "echo" }
        }
      ],
      "examples": [
        { "label": "Lire plages CH1-8", "frame": "01 03 10 00 00 08 40 CC" },
        { "label": "Réponse plages CH1-8 = 0-20 mA", "frame": "01 03 10 00 02 00 02 00 02 00 02 00 02 00 02 00 02 00 02 09 C3" },
        { "label": "Lire plage CH1", "frame": "01 03 10 00 00 01 80 CA" },
        { "label": "CH1 0-20 mA", "frame": "01 06 10 00 00 02 0C CB" },
        { "label": "CH1 4-20 mA", "frame": "01 06 10 00 00 03 CD 0B" },
        { "label": "CH2 4-20 mA", "frame": "01 06 10 01 00 03 9C CB" },
        { "label": "CH1-8 4-20 mA", "frame": "01 10 10 00 00 08 10 00 03 00 03 00 03 00 03 00 03 00 03 00 03 00 03 91 2B" },
        { "label": "Réponse CH1-8", "frame": "01 10 10 00 00 08 C5 0F" },
        { "label": "CH3-5 1-5 V", "frame": "01 10 10 02 00 03 06 00 01 00 01 00 01 BE 4A" }
      ]
    },
    {
      "id": "uart",
      "label": "Paramètres UART",
      "description": "Octet haut : parité, octet bas : code vitesse",
      "area": "holdingRegister",
      "access": "rw",
      "danger": true,
      "address": { "start": 8192, "count": 1 },
      "operations": [
        {
          "id": "read",
          "label": "Lire vitesse et parité",
          "function": "readHoldingRegisters",
          "fc": 3,
          "scope": "fixed",
          "params": { "length": 1 },
          "input": { "type": "none" },
          "result": {
            "type": "fields",
            "fields": [
              { "name": "parity", "label": "Parité (code)", "offset": 0, "type": "uint16", "formula": "floor(raw / 256)", "description": "Octet haut, cf. enum parity" },
              { "name": "baudRate", "label": "Vitesse (code)", "offset": 0, "type": "uint16", "formula": "mod(raw, 256)", "description": "Octet bas, cf. enum baudRate" }
            ]
          }
        },
        {
          "id": "set",
          "label": "Définir vitesse et parité",
          "function": "writeRegister",
          "fc": 6,
          "scope": "fixed",
          "input": {
            "type": "composite",
            "encode": "(parity << 8) | baudRate",
            "fields": [
              { "name": "parity", "enum": "parity", "byte": "high", "default": 0 },
              { "name": "baudRate", "enum": "baudRate", "byte": "low", "default": 1 }
            ]
          },
          "result": { "type": "echo" }
        }
      ],
      "examples": [
        { "label": "4800 N (broadcast)", "frame": "00 06 20 00 00 00 83 DB" },
        { "label": "9600 N (broadcast)", "frame": "00 06 20 00 00 01 42 1B" },
        { "label": "115200 N (broadcast)", "frame": "00 06 20 00 00 05 43 D8" }
      ]
    },
    {
      "id": "deviceAddress",
      "label": "Adresse du module",
      "area": "holdingRegister",
      "access": "rw",
      "danger": true,
      "address": { "start": 16384, "count": 1 },
      "operations": [
        {
          "id": "read",
          "label": "Lire l'adresse",
          "function": "readHoldingRegisters",
          "fc": 3,
          "scope": "fixed",
          "params": { "length": 1 },
          "input": { "type": "none" },
          "result": { "type": "number" }
        },
        {
          "id": "set",
          "label": "Changer l'adresse",
          "function": "writeRegister",
          "fc": 6,
          "scope": "fixed",
          "input": { "type": "number", "min": 1, "max": 255, "default": 1 },
          "result": { "type": "echo" }
        }
      ],
      "examples": [
        { "label": "Lire l'adresse (broadcast)", "frame": "00 03 40 00 00 01 90 1B" },
        { "label": "Réponse adresse = 1", "frame": "01 03 02 00 01 79 84" },
        { "label": "Réponse adresse = 2", "frame": "02 03 02 00 02 7D 85" },
        { "label": "Adresse -> 1", "frame": "00 06 40 00 00 01 5C 1B" },
        { "label": "Adresse -> 2", "frame": "00 06 40 00 00 02 1C 1A" },
        { "label": "Adresse -> 3", "frame": "00 06 40 00 00 03 DD DA" }
      ]
    },
    {
      "id": "version",
      "label": "Version logicielle",
      "area": "holdingRegister",
      "access": "r",
      "address": { "start": 32768, "count": 1 },
      "operations": [
        {
          "id": "read",
          "label": "Lire la version",
          "function": "readHoldingRegisters",
          "fc": 3,
          "scope": "fixed",
