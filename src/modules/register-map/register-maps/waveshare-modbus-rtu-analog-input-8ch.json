{
  "schemaVersion": 1,
  "conventions": {
    "numbers": "Adresses et valeurs en décimal ; le champ 'hex' n'est qu'affichage (valeur réellement émise sur le bus)",
    "requestBuild": "operation -> ComRequestConfigModel : { function: [operation.function], address, params: { length, value } }",
    "address": "scope 'channel' : block.address.start + index voie (0-based) × (address.stride ?? 1) ; scope 'range' et 'fixed' : block.address.start",
    "length": "operation.params.length si présent, sinon 1",
    "value": "input 'none' : input.fixedValue ; 'enum' : enum[].value ; 'number' : saisie brute ; 'enum[]' : tableau d'enum[].value ; 'composite' : input.encode",
    "channelLabel": "libellé voie = hardware.channels.labelStart + index",
    "inputUnit": "Unité de chaque voie selon son type de plage (registre 0x1000 + voie, lu via scopeFrom inputRanges.read), appliquée par unitFrom",
    "versions": "Version (A) : 0-5 V / 1-5 V, défaut 0-20 mA ; version (B) : 0-10 V / 2-10 V, défaut 0-10 V (code 0). Code brut 0-4095 : V = code × 3300 / 4095 / ratio ampli (A : 32.4/49.9, B : 10/32.4), I = V / résistance (A : 249 Ω, B : 499 Ω)",
    "jumpers": "Mode courant : cavalier de la voie fermé ; mode tension : cavalier ouvert (réglage matériel, non pilotable)",
    "danger": "true : l'opération peut couper la communication avec le module (confirmation requise)"
  },
  "_id": "0b1954ed-d9ae-4b28-8414-867a7ef136ac",
  "name": "WAVESHARE MODBUS RTU ANALOG INPUT 8CH",
  "description": "Waveshare Modbus RTU Analog Input 8CH - 8 entrées analogiques 12 bits (tension / courant)",
  "kind": "ANALOG_INPUT_8CH",
  "hardware": {
