{
  "schemaVersion": 1,
  "conventions": {
    "numbers": "Adresses et valeurs en décimal ; tous les registres sont des mots 16 bits ; adresses de la doc en hexa (0x07D0 → 2000, 0x0050 → 80), aucun décalage",
    "requestBuild": "operation -> ComRequestConfigModel : { function: [operation.function], address, params: { length, value } }",
    "address": "scope 'fixed' : block.address.start",
    "length": "operation.params.length si présent, sinon 1",
    "value": "input 'enum' : enum[].value ; 'number' : entier brut, négatif émis en complément à 2",
    "functionCodes": "La doc indique 0x30 / 0x60 : coquille pour 0x03 (lecture) / 0x06 (écriture), confirmée par les trames d'exemple",
    "scale": "Humidité, température et calibrations transmises × 10 (formule raw / 10)",
    "temperature": "Température signée en complément à 2 (0xFF9F = -97 → -9.7 °C)",
    "calibration": "Offsets de calibration (0x0050 / 0x0051) : signés, saisis bruts en 0.1 °C / 0.1 %RH ; valeur usine 0 supposée (non précisée par la doc)",
    "addressQuery": "Adresse 0xFF (255) acceptée en requête quand l'adresse est perdue : un seul capteur sur le bus, il répond avec son adresse réelle (ce n'est pas un broadcast Modbus)",
    "defaultValue": "Valeur usine du paramètre, au format de la valeur décodée du 1er champ (code enum ou nombre)",
    "views": "Blocs groupés (monitoring, calibration) : lecture des registres consécutifs en une trame, mêmes champs que les blocs unitaires",
    "danger": "true : l'opération peut couper la communication (confirmation requise)"
  },
